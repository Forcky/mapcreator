# Example only: a build worker (mapcreator-worker). It needs the base package plus boto3 (s3) for uploads;
# the [service] extra (FastAPI, uvicorn) is for the web side.
# Build from the repository root:
#   docker build -f deploy/examples/Dockerfile.worker -t mapcreator-worker:local .
# Pinned (Debian 13.7): a base-image change can't silently drop a library. Update on purpose.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN groupadd --system --gid 10001 mapcreator \
 && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home \
      --shell /usr/sbin/nologin mapcreator \
 && install -d -o 10001 -g 10001 /cache /scratch

# rasterio's and pyosmium's wheels bundle GDAL and libosmium, but both link the system's libexpat,
# which python:3.12-slim doesn't ship.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libexpat1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mapcreator
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
RUN pip install ".[s3]" && rm -rf /opt/mapcreator/src /opt/mapcreator/build

# Fail the image build, not the first job, if a library can't load.
RUN python -c "import rasterio, mapcreator.cli.main, mapcreator.service.worker"
USER 10001:10001
# Scratch space for each job's work folder; mount a size-limited tmpfs here.
ENV HOME=/scratch \
    TMPDIR=/scratch \
    XDG_CACHE_HOME=/scratch/.cache \
    MAPCREATOR_CACHE_DIR=/cache
CMD ["mapcreator-worker"]
