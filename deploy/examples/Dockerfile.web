# Example only: the public web front end, job queue and API (mapcreator-web).
# Build from the repository root:
#   docker build -f deploy/examples/Dockerfile.web -t mapcreator-web:local .
# Pinned (Debian 13.7): a base-image change can't silently drop a library. Update on purpose.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

# A fixed unprivileged user; the job database lives on a volume it owns.
RUN groupadd --system --gid 10001 mapcreator \
 && useradd --system --uid 10001 --gid 10001 --home-dir /nonexistent --no-create-home \
      --shell /usr/sbin/nologin mapcreator \
 && install -d -o 10001 -g 10001 /var/lib/mapcreator

# rasterio's and pyosmium's wheels bundle GDAL and libosmium, but both link the system's libexpat,
# which python:3.12-slim doesn't ship.
RUN apt-get update \
 && apt-get install -y --no-install-recommends libexpat1 \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/mapcreator
COPY pyproject.toml README.md LICENSE THIRD_PARTY_NOTICES.md ./
COPY src ./src
# The only network access at build time is pip fetching the package's dependencies.
RUN pip install ".[service,s3]" && rm -rf /opt/mapcreator/src /opt/mapcreator/build

# Fail the image build, not the first job, if a library can't load.
RUN python -c "import rasterio, mapcreator.service.api"
USER 10001:10001
ENV HOME=/tmp \
    MAPCREATOR_DB=/var/lib/mapcreator/jobs.sqlite3 \
    MAPCREATOR_STORAGE_DIR=/var/lib/mapcreator/downloads
EXPOSE 8000
CMD ["mapcreator-web", "--host", "0.0.0.0", "--port", "8000"]
