# Copy to config.local.toml (gitignored). Environment variables override these.

# cache_dir = "D:/mapcreator/cache"          # MAPCREATOR_CACHE_DIR
# work_dir = "D:/mapcreator/out"             # MAPCREATOR_WORK_DIR

# A local mirror of the Tasmania 2 m DEM is much faster than reading it over HTTP.
# tas_dem_source = "D:/mirror/Tasmania_Statewide_2m_DEM_14-08-2021.tif"   # MAPCREATOR_TAS_DEM

# theLIST 2 m canopy height model, unzipped from CHM_2M_STATEWIDE.zip (CHM_2m/TAS_CHM_2m.tif, ~10 GB).
# Without it, trees are placed from ESA WorldCover tree cover instead.
# tas_chm_source = "D:/mirror/TAS_CHM_2m.tif"                             # MAPCREATOR_TAS_CHM

# Without a canopy model, WorldCover's tree cells are kept only where Meta/WRI's canopy map also sees canopy.
# On by default; false reads WorldCover alone (no Meta/WRI download).
# meta_canopy = false                                                       # MAPCREATOR_META_CANOPY

# Roads (and buildings outside Tasmania) from a local OSM index instead of Overpass. Build it once from
# a Geofabrik extract: python -m mapcreator.providers.osm.index build australia-latest.osm.pbf <index>
# osm_index = "D:/mirror/osm/australia.sqlite"                             # MAPCREATOR_OSM_INDEX

# Without osm_index, roads come from Overpass: light development use only.
# overpass_url = "https://overpass-api.de/api/interpreter"                # MAPCREATOR_OVERPASS_URL
# user_agent = "mapcreator (+https://example.org/contact)"                 # MAPCREATOR_USER_AGENT

# In-game test harness (Windows, development only):
# ac_root = "C:/Program Files (x86)/Steam/steamapps/common/assettocorsa"
# cm_path = "C:/Games/Content Manager/Content Manager.exe"
# Only if AC's Documents folder isn't where Windows says Documents is (the harness asks Windows,
# so OneDrive-redirected Documents already work):
# ac_docs = "E:/Documents/Assetto Corsa"
